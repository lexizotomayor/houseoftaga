{#- Web Share with a copy-link fallback; wired up in assets/js/site.js. -#}
{% macro share(title, url) %}
<button class="share" type="button" data-share data-title="{{ title }}" data-url="{{ site.url }}{{ url }}" aria-label="Share this story"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="10.5" x2="15.4" y2="6.5"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/></svg><span data-share-label>share</span></button>
{% endmacro %}
