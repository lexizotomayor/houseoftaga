{#- Netlify Forms: submissions in Netlify → Forms → "contact"; enable email notifications there. -#}
<form class="form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/" data-ajax data-contact>
  <input type="hidden" name="form-name" value="contact">
  <p hidden><label>Leave empty <input name="bot-field"></label></p>
  <p class="page-lead">A story tip, a correction, a family photograph — hafa adai, write in.</p>
  <fieldset>
    <legend>what is it about</legend>
    <div class="chips">
      {%- for t in ["story tip", "correction", "photos & archives", "say hafa adai"] %}
      <label class="chip"><input type="radio" name="topic" value="{{ t }}"{% if loop.first %} checked{% endif %}><span>{{ t }}</span></label>
      {%- endfor %}
    </div>
  </fieldset>
  <div class="pair">
    <label class="field"><span>name</span><input name="name" required autocomplete="name" placeholder="Your name"></label>
    <label class="field"><span>email</span><input name="email" type="email" required autocomplete="email" placeholder="you@example.com"></label>
  </div>
  <label class="field"><span>message</span><textarea name="message" rows="7" required placeholder="Tell us what you know, or what you’re looking for."></textarea></label>
  <div class="submit-row">
    <span>We only use your details to reply. See <a class="u-red" href="/privacy/">privacy</a>.</span>
    <button class="btn" type="submit">send<span class="arrow" aria-hidden="true">→</span></button>
  </div>
  <p class="form-error" data-fail hidden role="alert">That didn’t go through. Please try again, or email {{ site.email }}.</p>
</form>
<div class="sent" data-sent hidden role="status" tabindex="-1">
  <span class="sq" aria-hidden="true"></span>
  <p class="big">Si Yu’os ma’åse’, <span data-first>friend</span>.</p>
  <p>Your message is on its way. Expect a reply at <span data-email></span> within a few days.</p>
  <button class="label-link" type="button" data-again><span class="tick" aria-hidden="true"></span>send another</button>
</div>
