---
layout: page.njk
title: About
pageName: about
pageNum: "01"
permalink: /about/
description: House of Taga is written by Lexi Zotomayor — the history of Saipan, Tinian and Rota, told one piece at a time.
---
{#- Text and portrait are edited in the CMS (Pages → About), stored in src/_data/about.json. -#}
<article class="about">
  <p class="page-lead">{{ about.lead }}</p>
  <div class="writer">
    <div class="portrait">{% if about.portrait %}<img src="{{ about.portrait }}" alt="{{ about.portraitAlt }}" width="600" height="720">{% else %}<span aria-hidden="true">portrait</span>{% endif %}</div>
    <div class="bio">
      <span class="cat cat--flat" style="align-self:flex-start">the writer</span>
      {%- for para in about.bio %}
      <p>{{ para }}</p>
      {%- endfor %}
    </div>
  </div>
  <div class="list-rows">
    <span class="kicker">four periods</span>
    {%- for p in periods %}
    <a href="/{{ p.key }}/"><span class="big-n">{{ p.num }}</span><span class="txt"><b>{{ p.name }}</b><span>{{ p.note }}</span></span></a>
    {%- endfor %}
  </div>
</article>
